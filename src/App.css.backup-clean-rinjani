/* =========================================================
   RINJANI AWESOME - CINEMATIC PHOTO BACKGROUND
   SAFE VERSION - DOES NOT HIDE LOGIN DOM
   ========================================================= */

.rinjani-3d-login,
.rinjani-command-scene {
  position: relative !important;
  width: 100% !important;
  min-height: 100vh !important;
  overflow: hidden !important;

  background-image:
    linear-gradient(
      180deg,
      rgba(255, 232, 190, 0.08) 0%,
      rgba(13, 52, 36, 0.12) 48%,
      rgba(4, 20, 13, 0.42) 100%
    ),
    url("/rinjani-sunset.jpg") !important;

  background-size: cover !important;
  background-position: center center !important;
  background-repeat: no-repeat !important;

  transform: none !important;
}

/* Landscape lama tidak lagi membuat background sendiri */
.rinjani-landscape {
  background: transparent !important;
  background-image: none !important;
  transform: none !important;
  opacity: 1 !important;
}

/* Hilangkan hanya efek dekorasi pseudo lama */
.rinjani-landscape::before,
.rinjani-landscape::after {
  pointer-events: none !important;
}

/* Jangan sembunyikan children landscape */

/* =========================================================
   BRAND
