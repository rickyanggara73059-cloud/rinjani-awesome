/* =========================================================
   RINJANI AWESOME — FULL SCREEN LOGIN
   ========================================================= */

.login-shell {
  position: relative;
  width: 100%;
  min-height: 100vh;
  min-height: 100dvh;
  display: grid;
  grid-template-columns: 55% 45%;
  overflow: hidden;
  background: #f7f9fc;
}

/* =========================================================
   LEFT SHOWCASE
   ========================================================= */

.login-showcase {
  position: relative;
  min-height: 100vh;
  min-height: 100dvh;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 72% 35%,
      rgba(27, 121, 255, 0.24),
      transparent 34%
    ),
    radial-gradient(
      circle at 20% 80%,
      rgba(22, 92, 214, 0.28),
      transparent 32%
    ),
    linear-gradient(
      145deg,
      #061a3d 0%,
      #062c6d 48%,
      #064aa0 100%
    );
  color: #ffffff;
}

.login-showcase::before {
  content: "";
  position: absolute;
  width: 520px;
  height: 520px;
  top: -260px;
  right: -160px;
  border: 1px solid rgba(111, 190, 255, 0.2);
  border-radius: 50%;
  box-shadow:
    0 0 0 80px rgba(85, 167, 255, 0.025),
    0 0 0 160px rgba(85, 167, 255, 0.02);
}

.login-showcase::after {
  content: "";
  position: absolute;
  left: -300px;
  bottom: -300px;
  width: 620px;
  height: 620px;
  border: 1px solid rgba(111, 190, 255, 0.18);
  border-radius: 50%;
}

.showcase-grid {
  position: absolute;
  inset: 0;
  opacity: 0.12;
  background-image:
    linear-gradient(
      rgba(255, 255, 255, 0.12) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.12) 1px,
      transparent 1px
    );
  background-size: 42px 42px;
  mask-image: linear-gradient(
    to bottom,
    black 0%,
    transparent 70%
  );
}

.showcase-orbit {
  position: absolute;
  border: 1px solid rgba(89, 185, 255, 0.16);
  border-radius: 50%;
  pointer-events: none;
}

.showcase-orbit--one {
  width: 420px;
  height: 420px;
  right: -220px;
  bottom: -160px;
}

.showcase-orbit--two {
  width: 280px;
  height: 280px;
  left: -180px;
  top: 52%;
}

.showcase-content {
  position: relative;
  z-index: 2;
  width: min(900px, calc(100% - 100px));
  min-height: 100vh;
  min-height: 100dvh;
  margin: 0 auto;
  padding: 52px 0 110px;
  display: flex;
  flex-direction: column;
}

.showcase-brand {
  display: flex;
  align-items: center;
  gap: 13px;
  margin-bottom: 52px;
}

.showcase-brand img {
  width: 48px;
  height: 48px;
  object-fit: contain;
  filter: brightness(0) invert(1);
}

.showcase-brand div {
  display: flex;
  flex-direction: column;
  line-height: 0.95;
}

.showcase-brand strong {
  font-size: 22px;
  font-weight: 850;
  letter-spacing: 0.03em;
}

.showcase-brand span {
  margin-top: 5px;
  color: #63baff;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.22em;
}

.showcase-badge {
  width: fit-content;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 18px;
  border: 1px solid rgba(126, 197, 255, 0.3);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.07);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.08),
    0 10px 35px rgba(0, 0, 0, 0.12);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.showcase-badge__dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #4bdcff;
  box-shadow: 0 0 12px #4bdcff;
}

.showcase-heading {
  max-width: 720px;
  margin-top: 30px;
}

.showcase-heading h1 {
  margin: 0;
  font-size: clamp(48px, 5vw, 76px);
  line-height: 0.98;
  font-weight: 850;
  letter-spacing: -0.045em;
}

.showcase-heading h1 span {
  background: linear-gradient(
    90deg,
    #63c7ff,
    #9edcff
  );
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.showcase-heading p {
  max-width: 650px;
  margin: 26px 0 8px;
  color: rgba(231, 242, 255, 0.78);
  font-size: 17px;
  line-height: 1.65;
}

.showcase-heading > strong {
  color: #59bcff;
  font-size: 15px;
}

.showcase-features {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-top: 34px;
}

.showcase-feature {
  min-height: 86px;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 15px;
  border: 1px solid rgba(141, 205, 255, 0.18);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.065);
  backdrop-filter: blur(14px);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.06),
    0 12px 30px rgba(0, 0, 0, 0.1);
}

.showcase-feature__icon {
  width: 44px;
  height: 44px;
  flex: 0 0 44px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: linear-gradient(
    145deg,
    rgba(72, 169, 255, 0.32),
    rgba(21, 91, 206, 0.3)
  );
  border: 1px solid rgba(106, 196, 255, 0.28);
  color: #a5dcff;
}

.showcase-feature strong,
.showcase-feature span {
  display: block;
}

.showcase-feature strong {
  font-size: 14px;
}

.showcase-feature span {
  margin-top: 4px;
  color: rgba(221, 237, 255, 0.6);
  font-size: 11px;
}

.showcase-summary {
  margin-top: auto;
  padding: 20px;
  border: 1px solid rgba(132, 204, 255, 0.25);
  border-radius: 18px;
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.09),
    rgba(255, 255, 255, 0.045)
  );
  backdrop-filter: blur(18px);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.07),
    0 24px 60px rgba(0, 0, 0, 0.15);
}

.summary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.summary-title,
.summary-status {
  display: flex;
  align-items: center;
  gap: 8px;
}

.summary-title {
  color: #cce9ff;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.summary-status {
  color: #7bd8a7;
  font-size: 11px;
}

.summary-status span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #42e08e;
  box-shadow: 0 0 10px rgba(66, 224, 142, 0.7);
}

.summary-body {
  display: grid;
  grid-template-columns: 1fr 1px 1fr;
  align-items: center;
  padding-top: 20px;
}

.summary-item {
  display: flex;
  align-items: center;
  gap: 15px;
}

.summary-item__icon {
  width: 52px;
  height: 52px;
  flex: 0 0 52px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: #68c4ff;
  background: rgba(25, 126, 242, 0.2);
  border: 1px solid rgba(54, 162, 255, 0.35);
}

.summary-item__icon--green {
  color: #5ce29d;
  background: rgba(35, 191, 118, 0.16);
  border-color: rgba(58, 220, 143, 0.35);
}

.summary-item strong,
.summary-item span {
  display: block;
}

.summary-item strong {
  font-size: 14px;
}

.summary-item span {
  margin-top: 5px;
  color: rgba(221, 237, 255, 0.58);
  font-size: 11px;
}

.summary-divider {
  width: 1px;
  height: 55px;
  background: rgba(255, 255, 255, 0.1);
}

.showcase-footer {
  position: absolute;
  z-index: 3;
  left: 50px;
  right: 50px;
  bottom: 28px;
  display: flex;
  justify-content: space-between;
  color: rgba(221, 237, 255, 0.48);
  font-size: 11px;
}

/* =========================================================
   RIGHT LOGIN PANEL
   ========================================================= */

.login-panel {
  position: relative;
  min-height: 100vh;
  min-height: 100dvh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: auto;
  background:
    radial-gradient(
      circle at 90% 10%,
      rgba(52, 137, 255, 0.08),
      transparent 25%
    ),
    #ffffff;
}

.login-panel::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  background:
    linear-gradient(
      135deg,
      transparent 0 78%,
      rgba(9, 77, 164, 0.025) 78% 100%
    );
}

.login-panel__inner {
  position: relative;
  z-index: 2;
  width: min(560px, calc(100% - 100px));
  padding: 50px 0;
}

.login-welcome-icon {
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  margin-bottom: 25px;
  border-radius: 17px;
  color: #0962d7;
  background: #edf5ff;
  box-shadow:
    0 12px 30px rgba(21, 98, 209, 0.08);
}

.login-welcome > span {
  display: block;
  margin-bottom: 15px;
  color: #075cc8;
  font-size: 13px;
  font-weight: 850;
  letter-spacing: 0.13em;
}

.login-welcome h2 {
  margin: 0;
  color: #111827;
  font-size: clamp(34px, 3vw, 46px);
  line-height: 1.08;
  font-weight: 750;
  letter-spacing: -0.035em;
}

.login-welcome h2 span {
  display: inline-block;
}

.login-welcome p {
  margin: 12px 0 0;
  color: #6b7890;
  font-size: 15px;
  line-height: 1.6;
}

.modern-login-form {
  margin-top: 37px;
}

.modern-login-field {
  display: block;
  margin-bottom: 25px;
}

.modern-login-field > span {
  display: block;
  margin-bottom: 10px;
  color: #344054;
  font-size: 13px;
  font-weight: 750;
}

.modern-login-input {
  height: 64px;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 0 18px;
  border: 1px solid #d9e1ed;
  border-radius: 15px;
  background: #ffffff;
  color: #8b9ab0;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.modern-login-input:focus-within {
  border-color: #146de0;
  background: #fbfdff;
  box-shadow:
    0 0 0 4px rgba(20, 109, 224, 0.09),
    0 12px 30px rgba(22, 94, 180, 0.07);
}

.modern-login-input input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: #182230;
  font: inherit;
  font-size: 15px;
}

.modern-login-input input::placeholder {
  color: #a4afbf;
}

.modern-login-input input:disabled {
  opacity: 0.65;
}

.modern-password-toggle {
  width: 30px;
  height: 30px;
  flex: 0 0 30px;
  display: grid;
  place-items: center;
  border: 0;
  background: transparent;
  color: #91a0b4;
  cursor: pointer;
}

.login-options {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: -3px;
  margin-bottom: 27px;
}

.remember-option {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #69778e;
  font-size: 13px;
  cursor: pointer;
}

.remember-option input {
  width: 19px;
  height: 19px;
  accent-color: #1168d8;
  cursor: pointer;
}

.forgot-password {
  border: 0;
  padding: 0;
  background: transparent;
  color: #075fc9;
  font: inherit;
  font-size: 13px;
  font-weight: 750;
  cursor: pointer;
}

.modern-login-error {
  margin: -7px 0 18px;
  padding: 12px 14px;
  border: 1px solid rgba(211, 61, 61, 0.18);
  border-radius: 11px;
  background: rgba(211, 61, 61, 0.06);
  color: #c23838;
  font-size: 13px;
  line-height: 1.5;
}

.modern-login-submit {
  width: 100%;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 13px;
  border: 0;
  border-radius: 15px;
  background: linear-gradient(
    100deg,
    #0759c9,
    #0874e8
  );
  color: #ffffff;
  font: inherit;
  font-size: 15px;
  font-weight: 800;
  cursor: pointer;
  box-shadow:
    0 16px 30px rgba(7, 89, 201, 0.22);
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    opacity 0.2s ease;
}

.modern-login-submit:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow:
    0 20px 35px rgba(7, 89, 201, 0.28);
}

.modern-login-submit:active:not(:disabled) {
  transform: translateY(0);
}

.modern-login-submit:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.login-register {
  display: flex;
  justify-content: center;
  gap: 5px;
  margin-top: 27px;
  color: #748197;
  font-size: 13px;
}

.login-register button {
  border: 0;
  padding: 0;
  background: transparent;
  color: #075fc9;
  font: inherit;
  font-weight: 750;
  cursor: pointer;
}

.login-secure {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 11px;
  margin-top: 29px;
  padding-top: 23px;
  border-top: 1px solid #e8edf3;
}

.login-secure__icon {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  color: #25b978;
  background: #effbf5;
}

.login-secure strong,
.login-secure span {
  display: block;
}

.login-secure strong {
  color: #66758b;
  font-size: 12px;
}

.login-secure span {
  margin-top: 4px;
  color: #a0aabd;
  font-size: 10px;
}

.login-copyright {
  margin-top: 32px;
  padding-top: 20px;
  border-top: 1px solid #edf0f4;
  color: #a3adbc;
  text-align: center;
  font-size: 10px;
}

.login-copyright strong {
  color: #1766ca;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1100px) {
  .login-shell {
    grid-template-columns: 50% 50%;
  }

  .showcase-content {
    width: min(900px, calc(100% - 60px));
  }

  .showcase-footer {
    left: 30px;
    right: 30px;
  }

  .showcase-heading h1 {
    font-size: 48px;
  }

  .showcase-features {
    grid-template-columns: 1fr;
  }

  .showcase-feature {
    min-height: 68px;
  }
}

@media (max-width: 820px) {
  .login-shell {
    display: block;
    overflow: visible;
  }

  .login-showcase {
    min-height: auto;
    padding-bottom: 45px;
  }

  .showcase-content {
    min-height: auto;
    width: calc(100% - 40px);
    padding: 35px 0 20px;
  }

  .showcase-brand {
    margin-bottom: 35px;
  }

  .showcase-heading h1 {
    font-size: clamp(42px, 10vw, 62px);
  }

  .showcase-heading p {
    font-size: 15px;
  }

  .showcase-summary {
    margin-top: 30px;
  }

  .showcase-footer {
    position: relative;
    left: auto;
    right: auto;
    bottom: auto;
    padding: 0 20px;
  }

  .login-panel {
    min-height: auto;
  }

  .login-panel__inner {
    width: calc(100% - 40px);
    padding: 55px 0 45px;
  }
}

@media (max-width: 560px) {
  .showcase-features {
    gap: 10px;
  }

  .summary-body {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .summary-divider {
    width: 100%;
    height: 1px;
  }

  .showcase-footer {
    flex-direction: column;
    gap: 5px;
    align-items: center;
  }

  .login-welcome h2 {
    font-size: 34px;
  }

  .login-options {
    gap: 15px;
  }

  .login-register {
    flex-direction: column;
    align-items: center;
  }
}

/* =========================================================
   DASHBOARD — PAYMENT IN CLICKABLE CARD
   ========================================================= */

.stat-card--clickable {
  width: 100%;
  text-align: left;
  cursor: pointer;
  transition:
    transform .18s ease,
    box-shadow .18s ease,
    border-color .18s ease;
}

.stat-card--clickable:hover {
  transform: translateY(-2px);
  border-color: #b8dcca;
  box-shadow: 0 10px 25px rgba(15, 118, 110, .09);
}

.stat-card--clickable:active {
  transform: translateY(0);
}

/* =========================================================
   PACKAGE DETAIL MODAL
   ========================================================= */

.package-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(7, 18, 35, 0.62);
  backdrop-filter: blur(6px);
}

.package-modal {
  width: min(680px, 100%);
  max-height: min(760px, calc(100vh - 48px));
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border: 1px solid #dfe7ef;
  border-radius: 20px;
  box-shadow: 0 24px 70px rgba(7, 18, 35, 0.25);
}

.package-modal__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  padding: 26px 28px 22px;
  border-bottom: 1px solid #e8edf3;
}

.package-modal__eyebrow {
  margin-bottom: 8px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: #059669;
}

.package-modal__header h2 {
  margin: 0;
  color: #0b1f3a;
  font-size: 25px;
  line-height: 1.2;
  font-weight: 800;
}

.package-modal__header p {
  margin: 8px 0 0;
  color: #718096;
  font-size: 13px;
  line-height: 1.6;
}

.package-modal__close {
  flex: 0 0 auto;
  width: 38px;
  height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #dce5ee;
  border-radius: 10px;
  background: #ffffff;
  color: #64748b;
  cursor: pointer;
  transition: 0.2s ease;
}

.package-modal__close:hover {
  background: #f8fafc;
  color: #0b1f3a;
  border-color: #cbd5e1;
}

.package-modal__body {
  overflow-y: auto;
  padding: 24px 28px;
}

.package-price-summary {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-bottom: 26px;
}

.package-price-summary > div {
  padding: 18px;
  border: 1px solid #e4eaf1;
  border-radius: 14px;
  background: #f8fafc;
}

.package-price-summary span {
  display: block;
  margin-bottom: 7px;
  color: #7b8ba1;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.package-price-summary strong {
  display: inline-block;
  color: #0b1f3a;
  font-size: 21px;
  font-weight: 800;
}

.package-price-summary small {
  display: block;
  margin-top: 4px;
  color: #8a98aa;
  font-size: 11px;
}

.package-tier-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 12px;
}

.package-tier-heading > div {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #0b1f3a;
}

.package-tier-heading > div svg {
  color: #059669;
}

.package-tier-heading strong {
  font-size: 14px;
}

.package-tier-heading > span {
  padding: 5px 10px;
  border-radius: 999px;
  background: #ecfdf5;
  color: #059669;
  font-size: 11px;
  font-weight: 800;
}

.package-tier-list {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.package-tier {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 15px 17px;
  border: 1px solid #e4eaf1;
  border-radius: 12px;
  background: #ffffff;
  transition: 0.2s ease;
}

.package-tier:hover {
  border-color: #b9dccc;
  background: #f8fffc;
  transform: translateY(-1px);
}

.package-tier__pax {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #475569;
}

.package-tier__pax svg {
  color: #059669;
}

.package-tier__pax strong {
  color: #0b1f3a;
  font-size: 13px;
}

.package-tier__price {
  color: #0b1f3a;
  font-size: 15px;
  font-weight: 800;
  text-align: right;
  white-space: nowrap;
}

.package-tier__price small {
  margin-left: 4px;
  color: #8a98aa;
  font-size: 10px;
  font-weight: 600;
}

.package-detail-loading {
  min-height: 150px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border: 1px dashed #d8e1ea;
  border-radius: 14px;
  color: #8a98aa;
  font-size: 13px;
}

.package-detail-loading svg {
  color: #94a3b8;
}

.package-modal__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 16px 28px;
  border-top: 1px solid #e8edf3;
  background: #f8fafc;
}

.package-modal__footer > span {
  color: #7b8ba1;
  font-size: 11px;
  line-height: 1.5;
}

.package-modal__footer .secondary-button {
  flex: 0 0 auto;
  min-width: 90px;
}

/* Mobile */
@media (max-width: 640px) {
  .package-modal-backdrop {
    padding: 12px;
    align-items: flex-end;
  }

  .package-modal {
    max-height: calc(100vh - 24px);
    border-radius: 18px 18px 0 0;
  }

  .package-modal__header {
    padding: 20px;
  }

  .package-modal__header h2 {
    font-size: 21px;
  }

  .package-modal__body {
    padding: 20px;
  }

  .package-price-summary {
    grid-template-columns: 1fr;
  }

  .package-tier {
    padding: 13px 14px;
  }

  .package-modal__footer {
    padding: 14px 20px;
  }
}


/* =========================================================
   RINJANI AWESOME — 3D COMMAND CENTER LOGIN
   ========================================================= */

.rinjani-3d-login {
  --rx: calc(var(--mouse-y, 0) * -5deg);
  --ry: calc(var(--mouse-x, 0) * 7deg);
  --green-deep: #061b12;
  --green: #0b3b25;
  --green-light: #166534;
  --gold: #c6a15b;
  --gold-light: #e4c87d;
  --cream: #f6f1e6;

  position: relative;
  isolation: isolate;
  overflow: hidden;

  width: 100%;
  min-height: 100dvh;

  display: flex;
  align-items: center;
  justify-content: center;

  background:
    radial-gradient(
      circle at 50% 38%,
      rgba(198,161,91,.11),
      transparent 24%
    ),
    radial-gradient(
      circle at 15% 85%,
      rgba(22,101,52,.28),
      transparent 32%
    ),
    linear-gradient(
      135deg,
      #020d08 0%,
      #061b12 46%,
      #03120b 100%
    );

  color: var(--cream);
}

.rinjani-command-scene {
  --mouse-x: 0;
  --mouse-y: 0;

  position: relative;

  width: min(1400px, 100%);
  min-height: 100dvh;

  perspective: 1600px;
  transform-style: preserve-3d;

  overflow: hidden;
}

/* =========================================================
   BACKGROUND
   ========================================================= */

.rinjani-3d-stars {
  position: absolute;
  inset: 0;

  pointer-events: none;
  z-index: -1;
}

.rinjani-3d-stars span {
  position: absolute;

  width: 2px;
  height: 2px;

  border-radius: 50%;

  background: rgba(228,200,125,.55);

  animation: rinjaniStar 4s ease-in-out infinite alternate;
}

.rinjani-3d-stars span:nth-child(1) { left: 7%; top: 14%; animation-delay: .2s; }
.rinjani-3d-stars span:nth-child(2) { left: 15%; top: 31%; animation-delay: 1s; }
.rinjani-3d-stars span:nth-child(3) { left: 24%; top: 12%; animation-delay: 1.7s; }
.rinjani-3d-stars span:nth-child(4) { left: 35%; top: 22%; animation-delay: .6s; }
.rinjani-3d-stars span:nth-child(5) { left: 48%; top: 9%; animation-delay: 2s; }
.rinjani-3d-stars span:nth-child(6) { left: 61%; top: 18%; animation-delay: .8s; }
.rinjani-3d-stars span:nth-child(7) { left: 74%; top: 11%; animation-delay: 1.4s; }
.rinjani-3d-stars span:nth-child(8) { left: 88%; top: 28%; animation-delay: .3s; }
.rinjani-3d-stars span:nth-child(9) { left: 93%; top: 58%; animation-delay: 1.2s; }
.rinjani-3d-stars span:nth-child(10) { left: 5%; top: 61%; animation-delay: 2.2s; }
.rinjani-3d-stars span:nth-child(11) { left: 18%; top: 76%; animation-delay: .4s; }
.rinjani-3d-stars span:nth-child(12) { left: 31%; top: 82%; animation-delay: 1.6s; }
.rinjani-3d-stars span:nth-child(13) { left: 68%; top: 78%; animation-delay: .9s; }
.rinjani-3d-stars span:nth-child(14) { left: 81%; top: 72%; animation-delay: 1.9s; }
.rinjani-3d-stars span:nth-child(15) { left: 91%; top: 83%; animation-delay: .7s; }
.rinjani-3d-stars span:nth-child(16) { left: 42%; top: 91%; animation-delay: 1.3s; }
.rinjani-3d-stars span:nth-child(17) { left: 55%; top: 67%; animation-delay: .5s; }
.rinjani-3d-stars span:nth-child(18) { left: 3%; top: 38%; animation-delay: 1.8s; }

.scene-light {
  position: absolute;

  width: 500px;
  height: 500px;

  border-radius: 50%;

  filter: blur(100px);

  pointer-events: none;
}

.scene-light--one {
  top: 18%;
  left: 20%;

  background: rgba(198,161,91,.07);

  animation: rinjaniLightOne 12s ease-in-out infinite alternate;
}

.scene-light--two {
  right: 10%;
  bottom: 10%;

  background: rgba(22,101,52,.16);

  animation: rinjaniLightTwo 15s ease-in-out infinite alternate;
}

/* =========================================================
   HEADER
   ========================================================= */

.rinjani-login-header {
  position: absolute;

  top: 30px;
  left: 40px;

  z-index: 30;

  display: flex;
  align-items: center;
  gap: 12px;

  animation: rinjaniHeaderIn .8s ease both;
}

.rinjani-logo {
  width: 48px;
  height: 48px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(198,161,91,.35);
  border-radius: 13px;

  background: rgba(5,27,17,.70);

  box-shadow:
    0 10px 30px rgba(0,0,0,.25),
    inset 0 0 20px rgba(198,161,91,.05);
}

.rinjani-logo img {
  width: 34px;
  height: 34px;
  object-fit: contain;
}

.rinjani-login-header div:last-child {
  display: flex;
  flex-direction: column;
}

.rinjani-login-header strong {
  color: #f1dfb1;

  font-family: Georgia, serif;

  font-size: 14px;
  letter-spacing: .15em;
}

.rinjani-login-header span {
  margin-top: 4px;

  color: #8fa094;

  font-size: 7px;
  font-weight: 700;

  letter-spacing: .17em;
}

/* =========================================================
   3D ENVIRONMENT
   ========================================================= */

.command-environment {
  position: absolute;

  left: 50%;
  top: 50%;

  width: min(1100px, 92vw);
  height: min(720px, 82vh);

  transform:
    translate(-50%, -48%)
    rotateX(var(--rx))
    rotateY(var(--ry));

  transform-style: preserve-3d;

  transition: transform .25s ease-out;

  animation: commandEnvironmentIn 1.1s cubic-bezier(.22,1,.36,1) both;
}

/* =========================================================
   MOUNTAIN
   ========================================================= */

.mountain-back {
  position: absolute;

  left: 50%;
  bottom: 25%;

  width: 760px;
  height: 330px;

  transform:
    translateX(-50%)
    translateZ(-180px);

  transform-style: preserve-3d;

  opacity: .42;
}

.mountain-peak {
  position: absolute;
  bottom: 0;

  width: 0;
  height: 0;

  border-left: 150px solid transparent;
  border-right: 150px solid transparent;
  border-bottom: 260px solid #0c2d1d;

  filter: drop-shadow(0 20px 20px rgba(0,0,0,.35));
}

.mountain-peak::after {
  content: "";

  position: absolute;

  left: -42px;
  top: 48px;

  width: 84px;
  height: 150px;

  background: linear-gradient(
    150deg,
    rgba(198,161,91,.12),
    transparent 70%
  );

  clip-path: polygon(50% 0,100% 100%,0 100%);
}

.mountain-peak--left {
  left: 0;
  transform: scale(.72);
  transform-origin: bottom;
}

.mountain-peak--center {
  left: 220px;

  border-left-width: 190px;
  border-right-width: 190px;
  border-bottom-width: 320px;

  border-bottom-color: #103b26;
}

.mountain-peak--right {
  right: -10px;

  transform: scale(.65);
  transform-origin: bottom;
}

/* =========================================================
   FLOOR
   ========================================================= */

.command-floor {
  position: absolute;

  left: 50%;
  bottom: 0;

  width: 900px;
  height: 290px;

  transform:
    translateX(-50%)
    rotateX(68deg)
    translateZ(-20px);

  transform-origin: bottom center;

  border: 1px solid rgba(198,161,91,.12);

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(198,161,91,.04),
      transparent
    );

  overflow: hidden;
}

.floor-grid {
  position: absolute;
  inset: -100%;

  background-image:
    linear-gradient(
      rgba(198,161,91,.10) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(198,161,91,.10) 1px,
      transparent 1px
    );

  background-size: 60px 60px;

  transform: perspective(500px) rotateX(5deg);

  animation: floorMove 8s linear infinite;
}

.floor-glow {
  position: absolute;

  left: 50%;
  top: 35%;

  width: 480px;
  height: 120px;

  transform: translateX(-50%);

  border-radius: 50%;

  background: rgba(198,161,91,.09);

  filter: blur(35px);
}

/* =========================================================
   MONITOR
   ========================================================= */

.command-monitor {
  position: absolute;

  left: 50%;
  top: 43%;

  width: 580px;
  height: 350px;

  transform:
    translate(-50%, -50%)
    translateZ(60px);

  border: 1px solid rgba(198,161,91,.34);
  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      rgba(9,35,23,.96),
      rgba(2,15,9,.97)
    );

  box-shadow:
    0 40px 80px rgba(0,0,0,.55),
    0 0 70px rgba(198,161,91,.07),
    inset 0 0 35px rgba(198,161,91,.035);

  transform-style: preserve-3d;

  animation: monitorFloat 5s ease-in-out infinite;
}

.command-monitor::before {
  content: "";

  position: absolute;
  inset: 7px;

  border: 1px solid rgba(255,255,255,.04);
  border-radius: 12px;

  pointer-events: none;
}

.monitor-topbar {
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 17px;

  border-bottom: 1px solid rgba(198,161,91,.13);
}

.monitor-brand {
  display: flex;
  align-items: center;
  gap: 7px;

  color: #c8b889;

  font-size: 8px;
  font-weight: 800;

  letter-spacing: .13em;
}

.status-dot {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #69a87d;

  box-shadow: 0 0 10px rgba(105,168,125,.65);

  animation: statusPulse 2s ease-in-out infinite;
}

.monitor-date {
  color: #64776b;

  font-size: 7px;
  letter-spacing: .12em;
}

.monitor-content {
  display: grid;
  grid-template-columns: 1fr 1fr;

  gap: 20px;

  padding: 28px;
}

.monitor-welcome {
  display: flex;
  flex-direction: column;
}

.monitor-welcome span {
  color: #c6a15b;

  font-size: 7px;
  font-weight: 800;

  letter-spacing: .18em;
}

.monitor-welcome strong {
  margin-top: 9px;

  color: #eee6d5;

  font-family: Georgia, serif;

  font-size: 25px;
  font-weight: 500;
}

.monitor-welcome small {
  margin-top: 8px;

  color: #788a7d;

  font-size: 10px;
}

.monitor-chart {
  position: relative;

  height: 120px;

  padding: 10px;

  border: 1px solid rgba(198,161,91,.10);
  border-radius: 10px;

  background: rgba(255,255,255,.018);

  overflow: hidden;
}

.chart-bars {
  position: absolute;

  left: 15px;
  right: 15px;
  bottom: 13px;

  height: 75px;

  display: flex;
  align-items: flex-end;
  gap: 8px;
}

.chart-bars i {
  flex: 1;

  min-height: 15px;

  border-radius: 3px 3px 0 0;

  background:
    linear-gradient(
      180deg,
      #c6a15b,
      rgba(198,161,91,.18)
    );

  animation: chartBars 3s ease-in-out infinite alternate;
}

.chart-bars i:nth-child(1) { height: 28%; }
.chart-bars i:nth-child(2) { height: 48%; animation-delay: .2s; }
.chart-bars i:nth-child(3) { height: 39%; animation-delay: .4s; }
.chart-bars i:nth-child(4) { height: 65%; animation-delay: .6s; }
.chart-bars i:nth-child(5) { height: 52%; animation-delay: .8s; }
.chart-bars i:nth-child(6) { height: 78%; animation-delay: 1s; }
.chart-bars i:nth-child(7) { height: 92%; animation-delay: 1.2s; }

.chart-line {
  position: absolute;

  left: 0;
  right: 0;

  height: 1px;

  background: rgba(198,161,91,.08);
}

.chart-line--one { top: 32%; }
.chart-line--two { top: 65%; }

.monitor-base {
  position: absolute;

  left: 50%;
  bottom: -60px;

  width: 145px;
  height: 60px;

  transform:
    translateX(-50%)
    translateZ(-10px);

  border-left: 1px solid rgba(198,161,91,.25);
  border-right: 1px solid rgba(198,161,91,.25);
}

.monitor-base::after {
  content: "";

  position: absolute;

  left: 50%;
  bottom: 0;

  width: 220px;
  height: 9px;

  transform: translateX(-50%);

  border-radius: 50%;

  background: #0b2115;

  border: 1px solid rgba(198,161,91,.24);

  box-shadow: 0 12px 20px rgba(0,0,0,.45);
}

/* =========================================================
   FLOATING CARDS
   ========================================================= */

.floating-card {
  position: absolute;

  z-index: 8;

  display: flex;
  align-items: center;
  gap: 10px;

  min-width: 155px;

  padding: 13px 14px;

  border: 1px solid rgba(198,161,91,.22);
  border-radius: 12px;

  background:
    linear-gradient(
      145deg,
      rgba(10,38,24,.92),
      rgba(3,17,10,.92)
    );

  box-shadow:
    0 20px 40px rgba(0,0,0,.30),
    inset 0 0 20px rgba(198,161,91,.025);

  backdrop-filter: blur(10px);

  transform-style: preserve-3d;

  animation: floatingCard 5s ease-in-out infinite;
}

.floating-card-icon {
  width: 34px;
  height: 34px;

  display: grid;
  place-items: center;

  flex-shrink: 0;

  border-radius: 9px;

  color: #d3b76f;

  background: rgba(198,161,91,.09);
  border: 1px solid rgba(198,161,91,.16);
}

.floating-card > div:last-child {
  display: flex;
  flex-direction: column;
}

.floating-card span {
  color: #728378;

  font-size: 6px;
  font-weight: 800;

  letter-spacing: .14em;
}

.floating-card strong {
  margin-top: 2px;

  color: #eee7d8;

  font-size: 17px;
}

.floating-card small {
  margin-top: 2px;

  color: #62826d;

  font-size: 7px;
}

.floating-card--customers {
  left: 4%;
  top: 24%;

  transform: translateZ(130px);

  animation-delay: -.8s;
}

.floating-card--trips {
  right: 3%;
  top: 22%;

  transform: translateZ(160px);

  animation-delay: -2.1s;
}

.floating-card--payment {
  left: 7%;
  bottom: 20%;

  transform: translateZ(110px);

  animation-delay: -3.4s;
}

/* =========================================================
   TASK / CALENDAR
   ========================================================= */

.floating-task,
.floating-calendar {
  position: absolute;
  z-index: 8;

  padding: 11px 13px;

  border: 1px solid rgba(198,161,91,.16);
  border-radius: 11px;

  background: rgba(4,22,14,.82);

  box-shadow: 0 18px 38px rgba(0,0,0,.30);

  backdrop-filter: blur(10px);
}

.floating-task {
  right: 8%;
  bottom: 20%;

  display: flex;
  align-items: center;
  gap: 8px;

  animation: floatingTask 6s ease-in-out infinite;
}

.task-check {
  color: #7db08b;
}

.floating-task > div:nth-child(2) {
  display: flex;
  flex-direction: column;
}

.floating-task strong {
  color: #ddd6c5;
  font-size: 8px;
}

.floating-task span {
  margin-top: 2px;
  color: #66796d;
  font-size: 7px;
}

.task-progress {
  width: 48px;
  height: 4px;

  margin-left: 5px;

  border-radius: 5px;

  background: rgba(255,255,255,.08);

  overflow: hidden;
}

.task-progress i {
  display: block;

  width: 75%;
  height: 100%;

  border-radius: inherit;

  background: #c6a15b;
}

.floating-calendar {
  left: 18%;
  top: 10%;

  display: flex;
  align-items: center;
  gap: 9px;

  color: #c6a15b;

  animation: floatingCalendar 7s ease-in-out infinite;
}

.floating-calendar div {
  display: flex;
  flex-direction: column;
}

.floating-calendar strong {
  color: #76867b;
  font-size: 6px;
  letter-spacing: .12em;
}

.floating-calendar span {
  margin-top: 3px;
  color: #ddd6c5;
  font-size: 8px;
}

.floating-calendar b {
  margin-top: 3px;
  color: #9b9f8b;
  font-size: 6px;
  font-weight: 500;
}

/* =========================================================
   ENTER BUTTON
   ========================================================= */

.enter-command {
  position: absolute;

  z-index: 20;

  left: 50%;
  bottom: 5%;

  display: flex;
  align-items: center;
  gap: 12px;

  padding: 10px 20px 10px 10px;

  transform:
    translateX(-50%)
    translateZ(200px);

  border: 1px solid rgba(198,161,91,.38);
  border-radius: 40px;

  color: #e6cf91;

  background:
    linear-gradient(
      135deg,
      rgba(12,52,32,.94),
      rgba(4,25,15,.94)
    );

  box-shadow:
    0 18px 45px rgba(0,0,0,.42),
    0 0 25px rgba(198,161,91,.08);

  cursor: pointer;

  transition:
    transform .3s ease,
    border-color .3s ease,
    box-shadow .3s ease;
}

.enter-command:hover {
  transform:
    translateX(-50%)
    translateY(-4px)
    translateZ(200px);

  border-color: rgba(228,200,125,.72);

  box-shadow:
    0 25px 55px rgba(0,0,0,.48),
    0 0 40px rgba(198,161,91,.16);
}

.enter-command-ring {
  position: absolute;
  inset: -7px;

  border: 1px solid rgba(198,161,91,.12);
  border-radius: inherit;

  animation: enterRing 2.5s ease-in-out infinite;
}

.enter-command-icon {
  width: 43px;
  height: 43px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  color: #152c1d;

  background:
    linear-gradient(
      135deg,
      #f0d791,
      #b68a3f
    );

  box-shadow:
    0 5px 18px rgba(198,161,91,.25);
}

.enter-command-text {
  display: flex;
  flex-direction: column;

  text-align: left;
}

.enter-command-text strong {
  font-size: 9px;
  letter-spacing: .15em;
}

.enter-command-text small {
  margin-top: 3px;

  color: #78897e;

  font-size: 7px;
}

/* =========================================================
   LOGIN PANEL
   ========================================================= */

.rinjani-login-panel {
  position: absolute;
  z-index: 40;

  top: 50%;
  right: 8%;

  width: min(390px, 90vw);

  opacity: 0;

  pointer-events: none;

  transform:
    translateY(-50%)
    translateZ(-100px)
    translateX(80px)
    scale(.82)
    rotateY(-10deg);

  transition:
    opacity .65s ease,
    transform 1.15s cubic-bezier(.22,1,.36,1);

  transform-style: preserve-3d;
}

.workspace-active .rinjani-login-panel {
  opacity: 1;

  pointer-events: auto;

  transform:
    translateY(-50%)
    translateZ(230px)
    translateX(0)
    scale(1)
    rotateY(0);
}

.rinjani-login-card {
  position: relative;

  padding: 31px;

  border: 1px solid rgba(198,161,91,.30);
  border-radius: 22px;

  background:
    linear-gradient(
      145deg,
      rgba(8,34,22,.97),
      rgba(3,18,11,.97)
    );

  box-shadow:
    0 35px 90px rgba(0,0,0,.58),
    0 0 55px rgba(198,161,91,.06),
    inset 0 0 35px rgba(198,161,91,.025);

  backdrop-filter: blur(20px);

  animation: loginCardFloat 5s ease-in-out infinite;
}

.rinjani-login-card::before {
  content: "";

  position: absolute;

  left: 15%;
  right: 15%;
  top: 0;

  height: 2px;

  background:
    linear-gradient(
      90deg,
      transparent,
      #c6a15b,
      #ead08d,
      #c6a15b,
      transparent
    );
}

.login-card-top {
  display: flex;
  align-items: center;
  gap: 10px;

  margin-bottom: 23px;
}

.login-card-icon {
  width: 39px;
  height: 39px;

  display: grid;
  place-items: center;

  color: #d6b96c;

  border: 1px solid rgba(198,161,91,.22);
  border-radius: 10px;

  background: rgba(198,161,91,.07);
}

.login-card-top div:last-child {
  display: flex;
  flex-direction: column;
}

.login-card-top span {
  color: #718278;

  font-size: 6px;
  font-weight: 800;

  letter-spacing: .17em;
}

.login-card-top strong {
  margin-top: 3px;

  color: #e7dfce;

  font-family: Georgia, serif;

  font-size: 14px;
  font-weight: 500;
}

.rinjani-login-heading > span {
  color: #c6a15b;

  font-size: 7px;
  font-weight: 800;

  letter-spacing: .18em;
}

.rinjani-login-heading h1 {
  margin: 7px 0 0;

  color: #f0eadc;

  font-family: Georgia, serif;

  font-size: 28px;
  font-weight: 500;

  line-height: 1.15;
}

.rinjani-login-heading p {
  margin: 8px 0 0;

  color: #85958a;

  font-size: 11px;
  line-height: 1.55;
}

.rinjani-login-form {
  display: flex;
  flex-direction: column;
  gap: 14px;

  margin-top: 22px;
}

.rinjani-login-form label {
  display: flex;
  flex-direction: column;
  gap: 7px;

  color: #b8c2b8;

  font-size: 10px;
  font-weight: 700;
}

.rinjani-login-input {
  display: flex;
  align-items: center;
  gap: 9px;

  min-height: 47px;

  padding: 0 13px;

  border: 1px solid rgba(198,161,91,.18);
  border-radius: 10px;

  background: rgba(0,0,0,.20);

  transition:
    border-color .25s ease,
    box-shadow .25s ease,
    transform .25s ease,
    background .25s ease;
}

.rinjani-login-input svg {
  flex-shrink: 0;

  color: #9e834d;
}

.rinjani-login-input:focus-within {
  border-color: rgba(198,161,91,.70);

  background: rgba(0,0,0,.30);

  box-shadow:
    0 0 0 3px rgba(198,161,91,.07),
    0 10px 25px rgba(0,0,0,.15);

  transform: translateY(-1px);
}

.rinjani-login-input input {
  width: 100%;
  min-width: 0;

  border: 0;
  outline: 0;

  background: transparent;

  color: #f0eadc;

  font-size: 12px;
}

.rinjani-login-input input::placeholder {
  color: #596960;
}

.rinjani-password-toggle {
  display: grid;
  place-items: center;

  padding: 4px;

  border: 0;
  background: transparent;

  color: #718177;

  cursor: pointer;
}

.rinjani-password-toggle:hover {
  color: #d1ae5d;
}

.rinjani-login-error {
  padding: 10px 12px;

  border: 1px solid rgba(207,90,90,.30);
  border-radius: 8px;

  background: rgba(130,35,35,.13);

  color: #e8a4a4;

  font-size: 10px;
  line-height: 1.5;
}

.rinjani-login-submit {
  position: relative;
  overflow: hidden;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  min-height: 49px;

  margin-top: 2px;

  border: 0;
  border-radius: 10px;

  background:
    linear-gradient(
      135deg,
      #c7a65f,
      #e7cc86,
      #a87d38
    );

  color: #102619;

  font-size: 10px;
  font-weight: 800;

  cursor: pointer;

  box-shadow:
    0 12px 28px rgba(0,0,0,.30);

  transition:
    transform .25s ease,
    box-shadow .25s ease;
}

.rinjani-login-submit::before {
  content: "";

  position: absolute;
  top: 0;
  left: -110%;

  width: 70%;
  height: 100%;

  transform: skewX(-20deg);

  background: rgba(255,255,255,.24);

  animation: loginShine 3.4s ease-in-out infinite;
}

.rinjani-login-submit:hover {
  transform: translateY(-2px);

  box-shadow:
    0 17px 35px rgba(0,0,0,.40);
}

.rinjani-login-submit:disabled {
  opacity: .65;
  cursor: not-allowed;
  transform: none;
}

.rinjani-login-security {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;

  margin-top: 17px;

  color: #627268;

  font-size: 7px;
  letter-spacing: .05em;
}

.rinjani-login-security svg {
  color: #8d7445;
}

/* =========================================================
   PARTICLES
   ========================================================= */

.command-particles {
  position: absolute;
  inset: 0;

  pointer-events: none;
}

.command-particles i {
  position: absolute;

  width: 4px;
  height: 4px;

  border-radius: 50%;

  background: #c6a15b;

  opacity: .4;

  box-shadow: 0 0 12px rgba(198,161,91,.5);

  animation: commandParticle 6s ease-in-out infinite;
}

.command-particles i:nth-child(1) {
  left: 28%;
  top: 27%;
}

.command-particles i:nth-child(2) {
  left: 68%;
  top: 19%;
  animation-delay: 1s;
}

.command-particles i:nth-child(3) {
  left: 76%;
  top: 55%;
  animation-delay: 2s;
}

.command-particles i:nth-child(4) {
  left: 21%;
  top: 60%;
  animation-delay: 3s;
}

.command-particles i:nth-child(5) {
  left: 48%;
  top: 12%;
  animation-delay: 1.5s;
}

.command-particles i:nth-child(6) {
  left: 57%;
  top: 78%;
  animation-delay: 2.5s;
}

/* =========================================================
   FOOTER
   ========================================================= */

.rinjani-login-footer {
  position: absolute;

  left: 40px;
  right: 40px;
  bottom: 24px;

  z-index: 30;

  display: flex;
  justify-content: space-between;

  color: #526259;

  font-size: 7px;

  letter-spacing: .12em;

  animation: rinjaniHeaderIn 1s .25s ease both;
}

/* =========================================================
   ACTIVE TRANSITION
   ========================================================= */

.workspace-active .command-monitor {
  animation:
    monitorMoveAside 1s cubic-bezier(.22,1,.36,1) forwards;
}

.workspace-active .floating-card,
.workspace-active .floating-task,
.workspace-active .floating-calendar,
.workspace-active .enter-command {
  opacity: 0;

  transform:
    translateZ(50px)
    scale(.75);

  pointer-events: none;

  transition:
    opacity .55s ease,
    transform .9s cubic-bezier(.22,1,.36,1);
}

.workspace-active .mountain-back {
  opacity: .18;

  transform:
    translateX(-50%)
    translateZ(-400px)
    scale(1.15);

  transition:
    opacity 1s ease,
    transform 1.2s ease;
}

.workspace-active .command-floor {
  opacity: .30;

  transition: opacity 1s ease;
}

/* =========================================================
   KEYFRAMES
   ========================================================= */

@keyframes commandEnvironmentIn {
  from {
    opacity: 0;
    transform:
      translate(-50%, -42%)
      scale(.92);
  }

  to {
    opacity: 1;
    transform:
      translate(-50%, -48%)
      scale(1);
  }
}

@keyframes rinjaniHeaderIn {
  from {
    opacity: 0;
    transform: translateY(-12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes monitorFloat {
  0%, 100% {
    transform:
      translate(-50%, -50%)
      translateZ(60px)
      translateY(0);
  }

  50% {
    transform:
      translate(-50%, -50%)
      translateZ(60px)
      translateY(-7px);
  }
}

@keyframes monitorMoveAside {
  to {
    transform:
      translate(-72%, -50%)
      translateZ(10px)
      scale(.82);
    opacity: .20;
  }
}

@keyframes floatingCard {
  0%, 100% {
    translate: 0 0;
  }

  50% {
    translate: 0 -8px;
  }
}

@keyframes floatingTask {
  0%, 100% {
    transform:
      translateZ(120px)
      translateY(0);
  }

  50% {
    transform:
      translateZ(120px)
      translateY(-7px);
  }
}

@keyframes floatingCalendar {
  0%, 100% {
    transform:
      translateZ(145px)
      translateY(0);
  }

  50% {
    transform:
      translateZ(145px)
      translateY(-6px);
  }
}

@keyframes loginCardFloat {
  0%, 100% {
    transform: translateZ(0);
  }

  50% {
    transform: translateZ(8px) translateY(-4px);
  }
}

@keyframes chartBars {
  from {
    filter: brightness(.85);
  }

  to {
    filter: brightness(1.15);
  }
}

@keyframes floorMove {
  from {
    transform:
      perspective(500px)
      rotateX(5deg)
      translateY(0);
  }

  to {
    transform:
      perspective(500px)
      rotateX(5deg)
      translateY(60px);
  }
}

@keyframes statusPulse {
  0%, 100% {
    opacity: .55;
  }

  50% {
    opacity: 1;
  }
}

@keyframes rinjaniStar {
  from {
    opacity: .15;
    transform: scale(.8);
  }

  to {
    opacity: .75;
    transform: scale(1.5);
  }
}

@keyframes rinjaniLightOne {
  from {
    transform: translate(0,0);
  }

  to {
    transform: translate(90px,50px);
  }
}

@keyframes rinjaniLightTwo {
  from {
    transform: translate(0,0);
  }

  to {
    transform: translate(-80px,-50px);
  }
}

@keyframes commandParticle {
  0%, 100% {
    opacity: .15;
    transform: translateY(0) scale(.8);
  }

  50% {
    opacity: .8;
    transform: translateY(-35px) scale(1.3);
  }
}

@keyframes enterRing {
  0%, 100% {
    opacity: .15;
    transform: scale(.97);
  }

  50% {
    opacity: .6;
    transform: scale(1.04);
  }
}

@keyframes loginShine {
  0% {
    left: -110%;
  }

  45%, 100% {
    left: 140%;
  }
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 900px) {
  .rinjani-login-header {
    top: 18px;
    left: 18px;
  }

  .rinjani-login-footer {
    left: 18px;
    right: 18px;
    bottom: 14px;
  }

  .command-environment {
    width: 100vw;
    height: 78vh;

    transform:
      translate(-50%, -48%)
      scale(.86);
  }

  .floating-card--customers {
    left: 1%;
  }

  .floating-card--trips {
    right: 1%;
  }

  .floating-card--payment {
    left: 2%;
  }

  .floating-task {
    right: 2%;
  }

  .floating-calendar {
    left: 8%;
  }

  .rinjani-login-panel {
    right: 50%;
    top: 50%;

    transform:
      translate(50%, -50%)
      translateZ(-100px)
      scale(.82);
  }

  .workspace-active .rinjani-login-panel {
    transform:
      translate(50%, -50%)
      translateZ(230px)
      scale(1);
  }

  .workspace-active .command-monitor {
    transform:
      translate(-50%, -50%)
      translateZ(-120px)
      scale(.72);

    opacity: .10;
  }
}

@media (max-width: 600px) {
  .rinjani-login-header {
    top: 14px;
    left: 14px;
  }

  .rinjani-logo {
    width: 40px;
    height: 40px;
  }

  .rinjani-logo img {
    width: 29px;
    height: 29px;
  }

  .rinjani-login-header strong {
    font-size: 11px;
  }

  .rinjani-login-header span {
    font-size: 5px;
  }

  .command-environment {
    height: 82vh;
    transform:
      translate(-50%, -46%)
      scale(.63);
  }

  .floating-card,
  .floating-task,
  .floating-calendar {
    display: none;
  }

  .command-monitor {
    width: 560px;
    height: 340px;
  }

  .mountain-back {
    opacity: .25;
  }

  .enter-command {
    bottom: 5%;
  }

  .rinjani-login-panel {
    width: calc(100vw - 28px);

    right: 50%;
  }

  .rinjani-login-card {
    padding: 25px 21px;
    border-radius: 18px;
  }

  .rinjani-login-heading h1 {
    font-size: 25px;
  }

  .rinjani-login-footer {
    display: none;
  }

  .workspace-active .command-environment {
    opacity: .22;
    pointer-events: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .rinjani-3d-login *,
  .rinjani-3d-login::before,
  .rinjani-3d-login::after {
    animation: none !important;
    transition-duration: .01ms !important;
  }
}


/* =========================================================
   RINJANI AWESOME — MOUNT RINJANI LANDSCAPE
   ========================================================= */

.rinjani-landscape {
  position: absolute;

  left: 50%;
  bottom: 15%;

  width: 1000px;
  height: 500px;

  transform:
    translateX(-50%)
    translateZ(-120px);

  transform-style: preserve-3d;

  pointer-events: none;

  opacity: .92;

  transition:
    transform 1.2s ease,
    opacity 1s ease;
}

/* GOLDEN SKY */

.rinjani-sky-glow {
  position: absolute;

  left: 50%;
  top: 8%;

  width: 460px;
  height: 260px;

  transform:
    translateX(-50%)
    translateZ(-80px);

  border-radius: 50%;

  background:
    radial-gradient(
      ellipse,
      rgba(218,181,94,.23) 0%,
      rgba(198,161,91,.09) 32%,
      transparent 72%
    );

  filter: blur(10px);

  animation: rinjaniSunGlow 7s ease-in-out infinite alternate;
}

/* CLOUDS */

.rinjani-cloud {
  position: absolute;

  height: 25px;

  border-radius: 50%;

  background: rgba(177,193,181,.055);

  filter: blur(13px);

  animation: rinjaniCloudMove 14s ease-in-out infinite alternate;
}

.rinjani-cloud--one {
  left: 3%;
  top: 43%;
  width: 190px;
}

.rinjani-cloud--two {
  right: 4%;
  top: 36%;
  width: 220px;

  animation-delay: -5s;
}

.rinjani-cloud--three {
  left: 31%;
  top: 51%;
  width: 300px;

  animation-delay: -9s;
}

/* =========================================================
   BACK MOUNTAIN
   ========================================================= */

.rinjani-mountain {
  position: absolute;

  transform-style: preserve-3d;

  overflow: hidden;

  clip-path: polygon(
    0 100%,
    9% 75%,
    19% 68%,
    28% 55%,
    37% 45%,
    45% 30%,
    50% 8%,
    55% 30%,
    63% 45%,
    73% 55%,
    82% 68%,
    92% 75%,
    100% 100%
  );
}

.rinjani-mountain--back {
  left: 8%;
  bottom: 25%;

  width: 84%;
  height: 270px;

  transform: translateZ(-160px);

  background:
    linear-gradient(
      155deg,
      #102f20 0%,
      #0b2518 48%,
      #06170e 100%
    );

  opacity: .48;
}

/* =========================================================
   MAIN RINJANI
   ========================================================= */

.rinjani-mountain--main {
  left: 17%;
  bottom: 20%;

  width: 66%;
  height: 360px;

  transform:
    translateZ(-80px)
    scale(1.08);

  background:
    linear-gradient(
      155deg,
      #24452d 0%,
      #173823 27%,
      #0e2a1a 55%,
      #06170e 100%
    );

  box-shadow:
    inset 60px -30px 80px rgba(0,0,0,.22);
}

/* RINJANI RIDGES */

.rinjani-ridge {
  position: absolute;

  bottom: 0;

  height: 100%;

  opacity: .55;
}

.rinjani-ridge--left {
  left: 0;

  width: 54%;

  background:
    linear-gradient(
      125deg,
      transparent 38%,
      rgba(5,18,11,.68) 39%,
      rgba(5,18,11,.68) 42%,
      transparent 43%
    );
}

.rinjani-ridge--right {
  right: 0;

  width: 58%;

  background:
    linear-gradient(
      235deg,
      transparent 40%,
      rgba(3,15,9,.70) 41%,
      rgba(3,15,9,.70) 44%,
      transparent 45%
    );
}

/* =========================================================
   SNOW / SUMMIT
   ========================================================= */

.rinjani-snow-cap {
  position: absolute;

  left: 50%;
  top: 8%;

  width: 105px;
  height: 76px;

  transform:
    translateX(-50%)
    rotate(1deg);

  clip-path: polygon(
    50% 0,
    67% 37%,
    100% 100%,
    70% 76%,
    52% 90%,
    31% 68%,
    0 100%,
    33% 36%
  );

  background:
    linear-gradient(
      145deg,
      #f0eadc,
      #c8d0c5 48%,
      rgba(153,171,157,.42)
    );

  opacity: .82;

  filter:
    drop-shadow(0 0 12px rgba(232,224,196,.08));
}

.rinjani-snow-cap span:first-child {
  position: absolute;

  left: 30px;
  top: 20px;

  width: 25px;
  height: 38px;

  background: rgba(255,255,255,.38);

  clip-path: polygon(
    50% 0,
    100% 100%,
    0 100%
  );
}

.rinjani-snow-cap span:last-child {
  position: absolute;

  right: 25px;
  top: 28px;

  width: 30px;
  height: 30px;

  background: rgba(255,255,255,.20);

  clip-path: polygon(
    50% 0,
    100% 100%,
    0 100%
  );
}

/* =========================================================
   CALDERA
   ========================================================= */

.rinjani-caldera {
  position: absolute;

  left: 50%;
  top: 43%;

  width: 230px;
  height: 82px;

  transform:
    translateX(-50%)
    rotateX(68deg)
    translateZ(7px);

  border-radius: 50%;

  border: 2px solid rgba(6,22,13,.78);

  background:
    radial-gradient(
      ellipse,
      rgba(4,20,12,.95) 0%,
      rgba(9,37,23,.75) 55%,
      transparent 72%
    );

  box-shadow:
    inset 0 0 35px rgba(0,0,0,.55),
    0 10px 30px rgba(0,0,0,.20);
}

.rinjani-caldera-inner {
  position: absolute;

  left: 50%;
  top: 50%;

  width: 135px;
  height: 45px;

  transform: translate(-50%, -50%);

  border-radius: 50%;

  border: 1px solid rgba(198,161,91,.12);

  background:
    radial-gradient(
      ellipse,
      rgba(3,14,9,.95),
      transparent 70%
    );
}

/* VALLEY */

.rinjani-valley {
  position: absolute;

  left: 27%;
  bottom: 0;

  width: 46%;
  height: 57%;

  background:
    linear-gradient(
      100deg,
      transparent 0%,
      rgba(3,18,11,.40) 48%,
      transparent 100%
    );

  clip-path: polygon(
    50% 0,
    100% 100%,
    0 100%
  );
}

/* =========================================================
   SEGARA ANAK
   ========================================================= */

.rinjani-lake {
  position: absolute;

  left: 50%;
  bottom: 15%;

  width: 350px;
  height: 85px;

  transform:
    translateX(-50%)
    translateZ(15px)
    rotateX(66deg);

  border-radius: 50%;

  background:
    radial-gradient(
      ellipse at 50% 35%,
      rgba(82,132,111,.44),
      rgba(23,76,54,.48) 48%,
      rgba(5,27,17,.76) 75%
    );

  border: 1px solid rgba(112,150,126,.20);

  box-shadow:
    0 0 45px rgba(52,109,79,.16),
    inset 0 0 25px rgba(190,201,173,.05);
}

.rinjani-lake span {
  position: absolute;

  left: 50%;
  top: 47%;

  transform:
    translate(-50%, -50%)
    rotateX(-66deg);

  color: rgba(202,211,194,.35);

  font-size: 7px;
  font-weight: 700;

  letter-spacing: .24em;

  white-space: nowrap;
}

.lake-reflection {
  position: absolute;

  left: 50%;
  top: 30%;

  width: 115px;
  height: 13px;

  transform: translateX(-50%);

  border-radius: 50%;

  background: rgba(213,190,119,.18);

  filter: blur(5px);
}

.lake-ripple {
  position: absolute;

  left: 50%;

  width: 170px;
  height: 15px;

  transform: translateX(-50%);

  border-top: 1px solid rgba(175,194,174,.16);

  border-radius: 50%;
}

.lake-ripple--one {
  top: 50%;
}

.lake-ripple--two {
  top: 67%;

  width: 110px;

  opacity: .6;
}

/* =========================================================
   FOREGROUND MOUNTAIN
   ========================================================= */

.rinjani-mountain--foreground {
  left: -5%;
  bottom: 7%;

  width: 110%;
  height: 160px;

  transform: translateZ(50px);

  background:
    linear-gradient(
      160deg,
      #092018,
      #04150d 70%
    );

  opacity: .82;

  clip-path: polygon(
    0 100%,
    0 70%,
    12% 62%,
    24% 70%,
    36% 55%,
    49% 68%,
