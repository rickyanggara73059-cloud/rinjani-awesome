/* =========================
   MODALS
   ========================= */

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(9, 17, 31, .58);
  backdrop-filter: blur(4px);
}

.customer-modal,
.customer-detail-modal {
  width: min(650px, 100%);
  max-height: calc(100vh - 40px);
  overflow-y: auto;
  border: 1px solid #e0e6ee;
  border-radius: 16px;
  background: #fff;
  box-shadow: 0 24px 70px rgba(8, 20, 39, .22);
}

.customer-detail-modal {
  width: min(620px, 100%);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 24px 25px 20px;
  border-bottom: 1px solid #edf1f6;
}

.modal-header > div:first-child {
  position: relative;
  padding-left: 53px;
}

.modal-icon {
  position: absolute;
  left: 0;
  top: 0;
  width: 41px;
  height: 41px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  color: #078d68;
  background: #eaf9f4;
}

.modal-header h2,
.detail-header h2 {
  margin: 0;
  color: #17243d;
  font-size: 20px;
}

.modal-header p {
  margin: 5px 0 0;
  color: #8390a4;
  font-size: 10px;
}

.modal-close {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  flex: 0 0 34px;
  border: 1px solid #e1e7ee;
  border-radius: 8px;
  color: #68768b;
  background: #fff;
}

.modal-close:hover {
  color: #17243d;
  background: #f7f9fb;
}

.customer-modal form {
  padding: 21px 25px 25px;
}

.form-section-title {
  margin-bottom: 12px;
  color: #8995a7;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .1em;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.form-grid label {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.form-grid label span {
  color: #59687e;
  font-size: 9px;
  font-weight: 800;
}

.form-grid input {
  width: 100%;
  height: 39px;
  padding: 0 11px;
  outline: 0;
  border: 1px solid #dce4ed;
  border-radius: 8px;
  color: #172033;
  background: #fbfcfe;
  font-size: 10px;
}

.form-grid input:focus {
  border-color: #54bea0;
  box-shadow: 0 0 0 3px rgba(7, 155, 114, .08);
}

.form-note {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 17px;
  padding: 10px 12px;
  color: #708097;
  background: #f6f9fb;
  border: 1px solid #e8edf3;
  border-radius: 8px;
  font-size: 9px;
}

.form-note svg {
  flex: 0 0 auto;
  color: #079b72;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  margin-top: 21px;
}

.modal-cancel {
  min-height: 40px;
  padding: 0 15px;
  border: 1px solid #dce4ed;
  border-radius: 8px;
  color: #617087;
  background: #fff;
  font-size: 10px;
  font-weight: 800;
}

.modal-cancel:hover {
  background: #f8fafc;
}

/* =========================
   CUSTOMER DETAIL
   ========================= */

.detail-header {
