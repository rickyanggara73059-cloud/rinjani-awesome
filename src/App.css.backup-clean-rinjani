:root {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #172033;
  background: #f5f7fa;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  min-height: 100vh;
  background: #f5f7fa;
}

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 40;
  width: 268px;
  display: flex;
  flex-direction: column;
  background: #101a2e;
  color: #d8e0ed;
  border-right: 1px solid #202c43;
}

.sidebar__brand {
  min-height: 78px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 20px;
  border-bottom: 1px solid #202c43;
}

.brand-mark {
  width: 40px;
  height: 40px;
  flex: 0 0 40px;
  display: grid;
  place-items: center;
  color: #0fa67a;
  background: #eefbf6;
  border-radius: 11px;
}

.brand-title {
  color: #fff;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 0.03em;
}

.brand-subtitle {
  margin-top: 3px;
  color: #62d6b0;
  font-size: 10px;
  font-weight: 600;
}

.sidebar__close {
  display: none;
  margin-left: auto;
  border: 0;
  background: transparent;
  color: #c9d3e4;
}

.sidebar__nav {
  flex: 1;
  overflow-y: auto;
  padding: 14px 12px;
}

.nav-section {
  margin: 20px 12px 8px;
  color: #7e8da9;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.nav-section--first {
  margin-top: 5px;
}

.nav-item {
  width: 100%;
  min-height: 44px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 13px;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: #cbd5e4;
  text-align: left;
  font-size: 13px;
  font-weight: 600;
  transition: 0.2s ease;
}

.nav-item:hover {
  color: #fff;
  background: #18253d;
}

.nav-item--active {
  color: #fff;
  background: #079b72;
  box-shadow: 0 8px 18px rgba(7, 155, 114, 0.18);
}

.nav-item--active:hover {
  background: #079b72;
}

.nav-badge {
  margin-left: auto;
  min-width: 25px;
  height: 21px;
  display: grid;
  place-items: center;
  padding: 0 7px;
  border-radius: 999px;
  color: #65e2bd;
  background: #123d38;
  font-size: 10px;
  font-weight: 800;
}

.nav-badge--warning {
  color: #ffd98a;
  background: #493a20;
}

.sidebar__footer {
  min-height: 54px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 20px;
  border-top: 1px solid #202c43;
  color: #8391aa;
  font-size: 10px;
}

.online-dot,
.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #12b886;
}

.version {
  margin-left: auto;
  color: #65738b;
}

.main-area {
  min-height: 100vh;
  margin-left: 268px;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  height: 70px;
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 0 30px;
  background: rgba(255, 255, 255, 0.94);
  border-bottom: 1px solid #e6ebf2;
  backdrop-filter: blur(12px);
}

.topbar__search {
  width: min(430px, 40vw);
  height: 40px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 13px;
  color: #9aa7b9;
  background: #f8fafc;
  border: 1px solid #dfe6ef;
  border-radius: 9px;
}

.topbar__search input {
  width: 100%;
  border: 0;
  outline: 0;
  color: #172033;
  background: transparent;
  font-size: 12px;
}

.topbar__search input::placeholder {
  color: #9aa7b9;
}

.topbar__right {
  position: relative;
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 12px;
}

.system-status {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 7px 11px;
  color: #087b5b;
  background: #effcf7;
  border: 1px solid #c6f1e3;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 700;
}

.icon-button {
  position: relative;
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border: 1px solid #dfe6ef;
  border-radius: 9px;
  color: #59687e;
  background: #fff;
}

.notification-button span {
  position: absolute;
  top: -5px;
  right: -5px;
  width: 17px;
  height: 17px;
  display: grid;
  place-items: center;
  border: 2px solid #fff;
  border-radius: 50%;
  color: #fff;
  background: #ef476f;
  font-size: 8px;
  font-weight: 800;
}

.admin-profile {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 4px 8px 4px 4px;
  border: 1px solid #dfe6ef;
  border-radius: 9px;
  background: #fff;
  color: #172033;
}

.admin-avatar {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  color: #fff;
  background: #078c68;
  font-size: 12px;
  font-weight: 800;
}

.admin-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.admin-info strong {
  font-size: 11px;
}

.admin-info small {
  margin-top: 2px;
  color: #8794a8;
  font-size: 9px;
}

.mobile-menu {
  display: none;
  width: 38px;
  height: 38px;
  border: 1px solid #dfe6ef;
  border-radius: 9px;
  background: #fff;
  color: #27344a;
}

.page-content {
  max-width: 1440px;
  margin: 0 auto;
  padding: 34px 34px 24px;
}

.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 25px;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 7px;
  color: #079b72;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.page-heading h1 {
  margin: 0;
  color: #14213a;
  font-size: clamp(24px, 2.3vw, 31px);
  line-height: 1.15;
  letter-spacing: -0.035em;
}

.page-heading p {
  margin: 8px 0 0;
  color: #718098;
  font-size: 12px;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 9px;
  font-size: 11px;
  font-weight: 800;
}

.primary-button {
  min-height: 41px;
  padding: 0 16px;
  border: 1px solid #078d68;
  color: #fff;
  background: #079b72;
  box-shadow: 0 7px 16px rgba(7, 155, 114, 0.16);
}

.primary-button:hover {
  background: #078a65;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 18px;
}

.stat-card,
.panel {
  background: #fff;
  border: 1px solid #e3e9f1;
  border-radius: 14px;
  box-shadow: 0 5px 18px rgba(20, 33, 58, 0.035);
}

.stat-card {
  padding: 19px 20px 16px;
}

.stat-card__top {
  display: flex;
  justify-content: space-between;
  gap: 10px;
}

.stat-card p {
  margin: 0;
  color: #6d7c93;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
}

.stat-card h2 {
  margin: 9px 0 0;
  color: #14213a;
  font-size: 25px;
  letter-spacing: -0.03em;
}

.stat-icon {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  color: #079b72;
  background: #ecfbf6;
}

.stat-card__bottom {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 17px;
  padding-top: 12px;
  border-top: 1px solid #edf1f6;
}

.stat-card__bottom span {
  color: #079b72;
  font-size: 10px;
  font-weight: 800;
}

.stat-card__bottom small {
  color: #8390a4;
  font-size: 9px;
}

.content-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(320px, 1fr);
  gap: 18px;
  margin-bottom: 18px;
}

.content-grid--bottom {
  grid-template-columns: 1fr 1fr;
}

.panel {
  min-width: 0;
  overflow: hidden;
}

.panel__header {
  min-height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 17px 21px;
  border-bottom: 1px solid #edf1f6;
}

.panel__header h3 {
  margin: 0;
  color: #17243d;
  font-size: 14px;
}

.panel__header p {
  margin: 5px 0 0;
  color: #8190a5;
  font-size: 10px;
}

.text-button {
  flex-shrink: 0;
  border: 0;
  color: #079b72;
  background: transparent;
  font-size: 10px;
  font-weight: 800;
}

.count-pill {
  min-width: 29px;
  height: 24px;
  display: grid;
  place-items: center;
  padding: 0 8px;
  border-radius: 999px;
  color: #087b5b;
  background: #eaf9f4;
  font-size: 10px;
  font-weight: 800;
}

.table-wrapper {
  overflow-x: auto;
}

table {
  width: 100%;
  min-width: 730px;
  border-collapse: collapse;
}

th {
  padding: 11px 14px;
  color: #8a96a8;
  background: #fafbfd;
  border-bottom: 1px solid #edf1f6;
  text-align: left;
  font-size: 9px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

td {
  padding: 13px 14px;
  color: #5d6b80;
  border-bottom: 1px solid #f0f3f7;
  font-size: 10px;
  white-space: nowrap;
}

tbody tr:last-child td {
  border-bottom: 0;
}

.customer-cell {
  display: flex;
  align-items: center;
  gap: 9px;
}

.customer-avatar {
  width: 31px;
  height: 31px;
  display: grid;
  place-items: center;
  flex: 0 0 31px;
  border-radius: 9px;
  color: #087b5b;
  background: #eaf9f4;
  font-size: 11px;
  font-weight: 800;
}

.customer-cell strong,
.customer-summary__item strong {
  display: block;
  color: #24324a;
  font-size: 10px;
}

.customer-cell small,
.customer-summary__item small {
  display: block;
  margin-top: 3px;
  color: #8a96a8;
  font-size: 9px;
}

.date-arrow {
  color: #a6b0bf;
}

.status {
  display: inline-flex;
  align-items: center;
  padding: 5px 8px;
  border-radius: 999px;
  font-size: 8px;
  font-weight: 800;
}

.status--ongoing {
  color: #087b5b;
  background: #eaf9f4;
}

.followup-list {
  padding: 6px 20px;
}

.followup-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 13px 0;
  border-bottom: 1px solid #f0f3f7;
}

.followup-item:last-child {
  border-bottom: 0;
}

.followup-avatar {
  width: 31px;
  height: 31px;
  display: grid;
  place-items: center;
  flex: 0 0 31px;
  border-radius: 50%;
  color: #5c3ab5;
  background: #f1ebff;
  font-size: 11px;
  font-weight: 800;
}

.followup-content {
  min-width: 0;
  flex: 1;
}

.followup-content strong {
  color: #24324a;
  font-size: 10px;
}

.followup-content small {
  margin-left: 5px;
  color: #8a96a8;
  font-size: 8px;
}

.followup-content p {
  margin: 5px 0 0;
  color: #64728a;
  font-size: 9px;
}

.followup-date {
  color: #079b72;
  font-size: 8px;
  font-weight: 800;
}

.secondary-button {
  width: calc(100% - 40px);
  min-height: 36px;
  margin: 6px 20px 17px;
  border: 1px solid #dce4ed;
  color: #55647b;
  background: #fff;
}

.secondary-button:hover {
  background: #f8fafc;
}

.upcoming-list {
  padding: 7px 20px 12px;
}

.upcoming-item {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 11px 0;
  border-bottom: 1px solid #f0f3f7;
}

.upcoming-item:last-child {
  border-bottom: 0;
}

.calendar-box {
  width: 39px;
  height: 42px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 0 0 39px;
  border-radius: 9px;
  color: #079b72;
  background: #effbf7;
}

.calendar-box svg {
  margin-bottom: 2px;
}

.calendar-box strong {
  font-size: 9px;
}

.upcoming-item > div:nth-child(2) {
  flex: 1;
}

.upcoming-item strong {
  color: #24324a;
  font-size: 10px;
}

.upcoming-item small {
  display: block;
  margin-top: 4px;
  color: #8a96a8;
  font-size: 8px;
}

.upcoming-item > span {
  color: #6c798d;
  font-size: 9px;
  font-weight: 700;
}

.customer-summary {
  padding: 7px 20px 12px;
}

.customer-summary__item {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 10px;
  padding: 11px 0;
  border-bottom: 1px solid #f0f3f7;
}

.customer-summary__item:last-child {
  border-bottom: 0;
}

.customer-summary__item > strong {
  color: #24324a;
  font-size: 10px;
}

.customer-avatar--gold {
  color: #8b6410;
  background: #fff7df;
}

.customer-avatar--blue {
  color: #2461a8;
  background: #eaf3ff;
}

.customer-avatar--purple {
  color: #6942ad;
  background: #f2ebff;
}

.dashboard-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 7px 2px 0;
  color: #96a1b1;
  font-size: 9px;
}

.dashboard-footer div {
  display: flex;
  align-items: center;
  gap: 6px;
}

.mobile-overlay {
  display: none;
}

@media (max-width: 1180px) {
  .sidebar {
    width: 235px;
  }

  .main-area {
    margin-left: 235px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .content-grid,
  .content-grid--bottom {
    grid-template-columns: 1fr;
  }

  .topbar {
    padding: 0 20px;
  }

  .page-content {
    padding: 27px 22px;
  }
}

@media (max-width: 820px) {
  .sidebar {
    width: 268px;
    transform: translateX(-100%);
    transition: transform 0.25s ease;
  }

  .sidebar--open {
    transform: translateX(0);
  }

  .sidebar__close {
    display: grid;
    place-items: center;
  }

  .mobile-overlay {
    position: fixed;
    inset: 0;
    z-index: 35;
    display: block;
    border: 0;
    background: rgba(9, 16, 29, 0.5);
  }

  .main-area {
    margin-left: 0;
  }

  .mobile-menu {
    display: grid;
    place-items: center;
  }

  .topbar {
    height: 62px;
    gap: 10px;
    padding: 0 14px;
  }

  .topbar__search {
    width: auto;
    flex: 1;
  }

  .system-status,
  .admin-info {
    display: none;
  }

  .page-content {
    padding: 22px 14px;
  }
}

@media (max-width: 560px) {
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .page-heading {
    align-items: stretch;
    flex-direction: column;
  }

  .primary-button {
    width: 100%;
  }

  .admin-profile {
    padding: 4px;
  }

  .topbar__right {
  position: relative;
    gap: 6px;
  }

  .dashboard-footer {
    align-items: flex-start;
    flex-direction: column;
  }
}

/* =========================
   CUSTOMERS
   ========================= */

.customers-page {
  width: 100%;
}

.customers-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 23px;
}

.customers-heading h1 {
  margin: 0;
  color: #14213a;
  font-size: clamp(24px, 2.3vw, 31px);
  line-height: 1.15;
  letter-spacing: -0.035em;
}

.customers-heading p {
  margin: 8px 0 0;
  color: #718098;
  font-size: 12px;
}

.customer-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
  margin-bottom: 18px;
}

.customer-stat-card {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 17px 18px;
  border: 1px solid #e3e9f1;
  border-radius: 13px;
  background: #fff;
  box-shadow: 0 5px 18px rgba(20, 33, 58, 0.035);
}

.customer-stat-icon {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  flex: 0 0 43px;
  border-radius: 11px;
}

.customer-stat-icon--green {
  color: #078d68;
  background: #eaf9f4;
}

.customer-stat-icon--blue {
  color: #2867b2;
  background: #eaf3ff;
}

.customer-stat-icon--purple {
  color: #6b43b5;
  background: #f2ebff;
}

.customer-stat-icon--gold {
  color: #9b6d0b;
  background: #fff6dc;
}

.customer-stat-card span {
  display: block;
  color: #748198;
  font-size: 9px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .06em;
}

.customer-stat-card strong {
  display: block;
  margin-top: 5px;
  color: #17243d;
  font-size: 19px;
  letter-spacing: -.025em;
}

.customer-stat-card small {
  display: block;
  margin-top: 3px;
  color: #9aa5b5;
  font-size: 8px;
}

.customer-table-panel {
  overflow: hidden;
  border: 1px solid #e3e9f1;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 5px 18px rgba(20, 33, 58, 0.035);
}

.customer-table-toolbar {
  min-height: 88px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 17px 21px;
  border-bottom: 1px solid #edf1f6;
}

.customer-table-toolbar h3 {
  margin: 0;
  color: #17243d;
  font-size: 14px;
}

.customer-table-toolbar p {
  margin: 5px 0 0;
  color: #8190a5;
  font-size: 10px;
}

.customer-search {
  width: min(320px, 100%);
  height: 38px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 12px;
  color: #9aa7b9;
  border: 1px solid #dfe6ef;
  border-radius: 8px;
  background: #f9fbfd;
}

.customer-search input {
  width: 100%;
  border: 0;
  outline: 0;
  background: transparent;
  color: #172033;
  font-size: 10px;
}

.customer-table-wrapper {
  overflow-x: auto;
}

.customer-table {
  width: 100%;
  min-width: 1050px;
  border-collapse: collapse;
}

.customer-table th {
  padding: 11px 16px;
  color: #8a96a8;
  background: #fafbfd;
  border-bottom: 1px solid #edf1f6;
  text-align: left;
  font-size: 9px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .06em;
}

.customer-table td {
  padding: 13px 16px;
  color: #66748a;
  border-bottom: 1px solid #f0f3f7;
  font-size: 10px;
  white-space: nowrap;
}

.customer-table tbody tr {
  transition: background .15s ease;
}

.customer-table tbody tr:hover {
  background: #fbfdfc;
}

.customer-table tbody tr:last-child td {
  border-bottom: 0;
}

.customer-main-cell {
  display: flex;
  align-items: center;
  gap: 10px;
}

.customer-avatar--large {
  width: 35px;
  height: 35px;
  flex-basis: 35px;
}

.customer-main-cell strong {
  display: block;
  color: #24324a;
  font-size: 10px;
}

.customer-main-cell small {
  display: block;
  margin-top: 3px;
  color: #8a96a8;
  font-size: 8px;
}

.country-cell,
.date-cell {
  display: flex;
  align-items: center;
  gap: 6px;
}

.country-cell svg,
.date-cell svg {
  color: #0a9c73;
}

.table-number {
