body {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden !important;
}

.rinjani-3d-login {
  width: 100vw !important;
  max-width: 100vw !important;
  min-height: 100dvh !important;
  overflow: hidden !important;
}

.rinjani-command-scene {
  width: 100% !important;
  max-width: 100% !important;
  min-height: 100dvh !important;
  height: 100dvh !important;
  overflow: hidden !important;
  perspective: 1000px !important;
}

/* =========================================================
   MOBILE HEADER
   ========================================================= */

@media (max-width: 600px) {

  .rinjani-login-header {
    top: 16px !important;
    left: 16px !important;
    right: 16px !important;

    gap: 9px !important;
  }

  .rinjani-logo {
    width: 38px !important;
    height: 38px !important;

    border-radius: 10px !important;
  }

  .rinjani-logo img {
    width: 27px !important;
    height: 27px !important;
  }

  .rinjani-login-header strong {
    font-size: 10px !important;
    letter-spacing: .12em !important;
  }

  .rinjani-login-header span {
    font-size: 5px !important;
    letter-spacing: .10em !important;
  }

  /* =======================================================
     3D SCENE
     ======================================================= */

  .command-environment {
    position: absolute !important;

    left: 50% !important;
    top: 52% !important;

    width: 100% !important;
    height: 72% !important;

    transform:
      translate(-50%, -50%) !important;

    overflow: visible !important;
  }

  /* =======================================================
     RINJANI LANDSCAPE
     Keep the large landscape but scale it to viewport
     ======================================================= */

  .rinjani-landscape {
    left: 50% !important;
    top: 50% !important;
    bottom: auto !important;

    width: 900px !important;
    height: 500px !important;

    transform:
      translate(-50%, -50%)
      translateZ(-100px)
      scale(.38) !important;

    transform-origin: center center !important;

    opacity: .92 !important;
  }

  .rinjani-mountain--main {
    height: 390px !important;
  }

  .rinjani-mountain--back {
    height: 300px !important;
  }

  .rinjani-sky-glow {
    width: 500px !important;
    height: 280px !important;
  }

  .rinjani-caldera {
    width: 280px !important;
    height: 90px !important;
  }

  .rinjani-lake {
    width: 350px !important;
    height: 90px !important;
  }

  .rinjani-landscape-label {
    display: none !important;
  }

  /* =======================================================
     COMMAND MONITOR
     ======================================================= */

  .command-monitor {
    left: 50% !important;
    top: 43% !important;

    width: calc(100vw - 42px) !important;
    max-width: 430px !important;

    height: 235px !important;

    transform:
      translate(-50%, -50%)
      translateZ(100px) !important;

    border-radius: 14px !important;
  }

  .monitor-topbar {
    height: 34px !important;

    padding: 0 12px !important;
  }

  .monitor-brand {
    font-size: 6px !important;
  }

  .monitor-date {
    font-size: 5px !important;
  }

  .monitor-content {
    grid-template-columns: 1fr !important;

    gap: 10px !important;

    padding: 17px !important;
  }

  .monitor-welcome strong {
    font-size: clamp(19px, 6vw, 25px) !important;
  }

  .monitor-welcome small {
    font-size: 8px !important;
  }

  .monitor-chart {
    height: 72px !important;
  }

  .chart-bars {
    height: 48px !important;

    left: 10px !important;
    right: 10px !important;
    bottom: 8px !important;

    gap: 5px !important;
  }

  .monitor-base {
    bottom: -38px !important;

    width: 90px !important;
    height: 38px !important;
  }

  .monitor-base::after {
    width: 135px !important;
    height: 7px !important;
  }

  /* =======================================================
     HIDE FLOATING DESKTOP CARDS
     ======================================================= */

  .floating-card,
  .floating-task,
  .floating-calendar {
    display: none !important;
  }

  /* =======================================================
     ENTER WORKSPACE
     ======================================================= */

  .enter-command {
    left: 50% !important;
    bottom: 5% !important;

    padding: 8px 16px 8px 8px !important;

    transform:
      translateX(-50%)
      translateZ(180px) !important;

    white-space: nowrap !important;
  }

  .enter-command:hover {
    transform:
      translateX(-50%)
      translateY(-2px)
      translateZ(180px) !important;
  }

  .enter-command-icon {
    width: 38px !important;
    height: 38px !important;
  }

  .enter-command-text strong {
    font-size: 8px !important;
  }

  .enter-command-text small {
    font-size: 6px !important;
  }

  /* =======================================================
     LOGIN PANEL MOBILE
     ======================================================= */

  .rinjani-login-panel {
    position: absolute !important;

    left: 50% !important;
    right: auto !important;
    top: 50% !important;

    width: calc(100vw - 28px) !important;
    max-width: 410px !important;

    transform:
      translate(-50%, -50%)
      translateZ(-150px)
      scale(.88) !important;
  }

  .workspace-active .rinjani-login-panel {
    transform:
      translate(-50%, -50%)
      translateZ(250px)
      scale(1) !important;
  }

  .rinjani-login-card {
    width: 100% !important;
    box-sizing: border-box !important;

    padding: 22px 18px !important;

    border-radius: 17px !important;
  }

  .login-card-top {
    margin-bottom: 17px !important;
  }

  .login-card-icon {
    width: 34px !important;
    height: 34px !important;
  }

  .rinjani-login-heading h1 {
    font-size: 23px !important;
    line-height: 1.12 !important;
  }

  .rinjani-login-heading p {
    font-size: 10px !important;
  }

  .rinjani-login-form {
    gap: 11px !important;

    margin-top: 17px !important;
  }

  .rinjani-login-input {
    min-height: 45px !important;
  }

  .rinjani-login-submit {
    min-height: 46px !important;
  }

  /* =======================================================
     AFTER ENTER
     ======================================================= */

  .workspace-active .command-environment {
    opacity: .10 !important;
    pointer-events: none !important;
  }

  .workspace-active .command-monitor {
    transform:
      translate(-50%, -50%)
      translateZ(-300px)
      scale(.65) !important;

    opacity: .08 !important;
  }

  .workspace-active .rinjani-landscape {
    transform:
      translate(-50%, -50%)
      translateZ(-450px)
      scale(.46) !important;

    opacity: .12 !important;
  }

  /* =======================================================
     MOBILE FOOTER
     ======================================================= */

  .rinjani-login-footer {
    display: none !important;
  }

  /* =======================================================
     PARTICLES
     ======================================================= */

  .command-particles i {
    width: 3px !important;
    height: 3px !important;
  }
}

/* =========================================================
   VERY SMALL PHONES
   ========================================================= */

@media (max-width: 380px) {

  .rinjani-login-header {
    top: 11px !important;
    left: 11px !important;
  }

  .rinjani-logo {
    width: 34px !important;
    height: 34px !important;
  }

  .rinjani-login-header strong {
    font-size: 9px !important;
  }

  .rinjani-login-header span {
    font-size: 4px !important;
  }

  .command-environment {
    top: 51% !important;
    height: 70% !important;
  }

  .command-monitor {
    width: calc(100vw - 28px) !important;
    height: 215px !important;
  }

  .monitor-content {
    padding: 14px !important;
  }

  .monitor-welcome strong {
    font-size: 18px !important;
  }

  .monitor-chart {
    height: 60px !important;
  }

  .chart-bars {
    height: 40px !important;
  }

  .enter-command {
    bottom: 4% !important;
  }

  .rinjani-login-card {
    padding: 19px 15px !important;
  }

  .rinjani-login-heading h1 {
    font-size: 21px !important;
  }
}

/* =========================================================
   LANDSCAPE PHONE
   ========================================================= */

@media (max-width: 900px) and (orientation: landscape) {

  .rinjani-login-header {
    top: 10px !important;
    left: 14px !important;
  }

  .command-environment {
    height: 100vh !important;
    top: 50% !important;
  }

  .command-monitor {
    top: 46% !important;
    height: 190px !important;
  }

  .monitor-content {
    grid-template-columns: 1fr 1fr !important;
  }

  .monitor-chart {
    height: 100px !important;
  }

  .enter-command {
    bottom: 3% !important;
  }
}


/* =========================================================
   MOBILE LOGIN — FINAL OVERFLOW FIX
   Login card must always fit the phone viewport
   ========================================================= */

@media (max-width: 600px) {

  /* Prevent every parent from creating horizontal overflow */
  .rinjani-3d-login,
  .rinjani-command-scene,
  .command-environment {
    width: 100vw !important;
    max-width: 100vw !important;
    overflow: hidden !important;
  }

  /*
   * Once ENTER WORKSPACE is clicked:
   * remove the login panel from the 3D coordinate system.
   */
  .workspace-active .rinjani-login-panel {
    position: fixed !important;

    inset: 0 !important;

    width: 100vw !important;
    max-width: 100vw !important;
    height: 100dvh !important;

    margin: 0 !important;
    padding: 16px !important;

    box-sizing: border-box !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    opacity: 1 !important;

    pointer-events: auto !important;

    /*
     * IMPORTANT:
     * no translateZ / rotate / scale here.
     */
    transform: none !important;

    perspective: none !important;

    overflow-y: auto !important;
    overflow-x: hidden !important;

    z-index: 9999 !important;
  }

  /*
   * Login card is now a normal responsive card.
   */
  .workspace-active .rinjani-login-card {
    position: relative !important;

    width: 100% !important;
    max-width: 390px !important;

    min-width: 0 !important;

    margin: auto !important;

    box-sizing: border-box !important;

    padding: 24px 18px !important;

    transform: none !important;

    animation: mobileLoginAppear .65s cubic-bezier(.22,1,.36,1) both !important;
  }

  /* Header inside card */
  .workspace-active .login-card-top {
    width: 100% !important;
    box-sizing: border-box !important;
  }

  .workspace-active .rinjani-login-heading {
    width: 100% !important;
    box-sizing: border-box !important;
  }

  .workspace-active .rinjani-login-heading h1 {
    width: 100% !important;

    font-size: clamp(21px, 6vw, 27px) !important;

    line-height: 1.16 !important;

    overflow-wrap: break-word !important;
  }

  .workspace-active .rinjani-login-heading p {
    width: 100% !important;

    font-size: 10px !important;

    line-height: 1.5 !important;
  }

  /* Form */
  .workspace-active .rinjani-login-form {
    width: 100% !important;

    box-sizing: border-box !important;
  }

  .workspace-active .rinjani-login-form label {
    width: 100% !important;

    min-width: 0 !important;
  }

  /*
   * Inputs must never exceed card width.
   */
  .workspace-active .rinjani-login-input {
    width: 100% !important;

    min-width: 0 !important;

    box-sizing: border-box !important;

    overflow: hidden !important;
  }

  .workspace-active .rinjani-login-input input {
    width: 100% !important;
    min-width: 0 !important;

    box-sizing: border-box !important;
  }

  .workspace-active .rinjani-login-submit {
    width: 100% !important;

    box-sizing: border-box !important;
  }

  .workspace-active .rinjani-login-security {
    width: 100% !important;

    box-sizing: border-box !important;

    white-space: normal !important;

    text-align: center !important;
  }

  /*
   * Hide the 3D scene completely behind the login.
   * This prevents the scene from affecting mobile layout.
   */
  .workspace-active .command-environment {
    opacity: 0 !important;

    visibility: hidden !important;

    pointer-events: none !important;

    transform: none !important;
  }

  .workspace-active .rinjani-3d-stars {
    opacity: .35 !important;
  }
}

/* =========================================================
   SMALL PHONE
   ========================================================= */

@media (max-width: 380px) {

  .workspace-active .rinjani-login-panel {
    padding: 12px !important;
  }

  .workspace-active .rinjani-login-card {
    max-width: 100% !important;

    padding: 21px 15px !important;

    border-radius: 16px !important;
  }

  .workspace-active .login-card-top {
    margin-bottom: 15px !important;
  }

  .workspace-active .login-card-icon {
    width: 32px !important;
    height: 32px !important;
  }

  .workspace-active .rinjani-login-heading h1 {
    font-size: 20px !important;
  }

  .workspace-active .rinjani-login-heading p {
    font-size: 9px !important;
  }

  .workspace-active .rinjani-login-form {
    margin-top: 15px !important;
    gap: 10px !important;
  }

  .workspace-active .rinjani-login-input {
    min-height: 43px !important;
  }

  .workspace-active .rinjani-login-submit {
    min-height: 44px !important;
  }
}

/* =========================================================
   LOGIN ENTRY ANIMATION
   ========================================================= */

@keyframes mobileLoginAppear {

  from {
    opacity: 0;

    transform:
      translateY(35px)
      scale(.94);
  }

  to {
    opacity: 1;

    transform:
      translateY(0)
      scale(1);
  }
}


/* =========================================================
   RINJANI AWESOME — DESKTOP LOGIN POSITION FIX
   Mobile layout tetap menggunakan patch sebelumnya.
   ========================================================= */

@media (min-width: 901px) {

  /*
   * LOGIN PANEL DESKTOP
   * Lepaskan dari batas width command-scene.
   * Form selalu berada di dalam viewport.
   */

  .workspace-active .rinjani-login-panel {
    position: fixed !important;

    top: 50% !important;
    right: clamp(28px, 5vw, 80px) !important;
    left: auto !important;

    width: min(390px, 30vw) !important;
    max-width: 390px !important;

    box-sizing: border-box !important;

    margin: 0 !important;

    transform:
      translateY(-50%)
      translateZ(0)
      scale(1) !important;

    z-index: 9999 !important;

    opacity: 1 !important;

    pointer-events: auto !important;
  }

  /*
   * Jangan biarkan transform dari parent 3D
   * memotong login card.
   */
  .workspace-active .rinjani-login-card {
    width: 100% !important;
    max-width: 390px !important;

    box-sizing: border-box !important;

    transform: none !important;
  }

  /*
   * Monitor mundur ke kiri ketika login aktif.
   */
  .workspace-active .command-monitor {
    transform:
      translate(-72%, -50%)
      translateZ(20px)
      scale(.82) !important;

    opacity: .20 !important;
  }

  /*
   * Rinjani tetap terlihat di belakang.
   */
  .workspace-active .rinjani-landscape {
    opacity: .30 !important;

    transform:
      translateX(-58%)
      translateZ(-500px)
      scale(1.18) !important;
  }

  /*
   * Jangan sampai scene membuat horizontal scrollbar.
   */
  .rinjani-3d-login,
  .rinjani-command-scene {
    overflow-x: hidden !important;
  }

  /*
   * Login card tidak boleh lebih tinggi dari viewport.
   */
  .workspace-active .rinjani-login-panel {
    max-height: calc(100dvh - 48px) !important;

    overflow-y: auto !important;
    overflow-x: hidden !important;

    scrollbar-width: thin;
  }

  .workspace-active .rinjani-login-card {
    margin: 0 auto !important;
  }
}

/* =========================================================
   LARGE DESKTOP / LAPTOP
   ========================================================= */

@media (min-width: 901px) and (max-width: 1200px) {

  .workspace-active .rinjani-login-panel {
    right: 28px !important;

    width: 360px !important;
    max-width: 360px !important;
  }

  .workspace-active .command-monitor {
    transform:
      translate(-78%, -50%)
      translateZ(10px)
      scale(.74) !important;

    opacity: .16 !important;
  }
}

/* =========================================================
   WIDE DESKTOP
   ========================================================= */

@media (min-width: 1500px) {

  .workspace-active .rinjani-login-panel {
    right: 5vw !important;
  }

  .workspace-active .rinjani-login-card {
    padding: 31px !important;
  }
}


/* =========================================================
   RINJANI AWESOME — BRIGHT SUNSET EDITION
   Green + White + Sunset
   ========================================================= */

/* ---------------------------------------------------------
   MAIN ATMOSPHERE
   --------------------------------------------------------- */

.rinjani-3d-login,
.rinjani-command-scene {
  background:
    radial-gradient(
      ellipse at 50% 25%,
      rgba(255,196,104,.30) 0%,
      rgba(244,158,72,.14) 18%,
      transparent 42%
    ),
    linear-gradient(
      180deg,
      #b9e3d0 0%,
      #6fb99a 24%,
      #287451 55%,
      #0e4930 78%,
      #073522 100%
    ) !important;

  color: #17382a !important;
}

/* ---------------------------------------------------------
   SKY
   --------------------------------------------------------- */

.rinjani-sky-glow {
  width: 720px !important;
  height: 420px !important;

  top: 0 !important;

  background:
    radial-gradient(
      ellipse at center,
      rgba(255,214,137,.95) 0%,
